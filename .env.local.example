# Cloudinary configuration (Replace with your actual keys in .env.local)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
CLOUDINARY_FOLDER=sky_cabs_bangalore

# Authentication
NEXTAUTH_URL=https://skycabsbangalore.com/
NEXTAUTH_SECRET=your_random_secure_jwt_secret_here

# OpenRouter AI (for Review generation, OCR analysis, customer assistant)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Maps API (Optional for interactive maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# LocationIQ API (Free Tier: 5,000 requests/day, 150,000/mo - no credit card required at locationiq.com)
NEXT_PUBLIC_LOCATIONIQ_API_KEY=your_locationiq_api_key_here

# Cloudflare D1 Credentials (for remote D1 queries from outside workers)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_DATABASE_ID=your_d1_database_id_here
CLOUDFLARE_D1_TOKEN=your_cloudflare_api_token_here
