{
  "name": "chisfis-nextjs",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watchAll",
    "predev": "node -e \"try{fs.rmSync('public/_next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev",
    "prebuild": "node -e \"try{fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('public/_next',{recursive:true,force:true})}catch(e){}\"",
    "build": "next build",
    "clean": "node -e \"try{fs.rmSync('.next',{recursive:true,force:true});fs.rmSync('public/_next',{recursive:true,force:true})}catch(e){}\"",
    "start": "next start",
    "lint": "eslint src",
    "cf:build": "next build",
    "cf:bundle": "node scripts/prepare-cf-deploy.js",
    "cf:deploy": "next build && node scripts/prepare-cf-deploy.js && wrangler pages deploy out-cf --project-name=sri-sadhguru-travels --commit-dirty=true",
    "cf:d1:init": "wrangler d1 execute sadhguru-db --remote --file=./src/lib/db/schema.sql",
    "cf:d1:local": "wrangler d1 execute sadhguru-db --local --file=./src/lib/db/schema.sql"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/google-map-react": "^2.1.7",
    "@types/react-datepicker": "^4.11.2",
    "client-only": "^0.0.1",
    "eslint": "8.41.0",
    "eslint-config-next": "^16.4.6",
    "framer-motion": "^14.14.0",
    "google-map-react": "^2.2.1",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "ogl": "^1.0.11",
    "rc-slider": "^11.1.9",
    "react": "^19.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.3.1",
    "react-hooks-global-state": "^2.1.0",
    "react-swipeable": "^7.0.2",
    "react-use": "^17.6.1",
    "react-use-keypress": "^1.3.1",
    "sass": "^1.108.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@cloudflare/next-on-pages": "^1.13.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "typescript": "^5.5.4",
    "wrangler": "^4.165.0"
  }
}
